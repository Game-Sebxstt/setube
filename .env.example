# Todas son de BUILD (se incrustan en el bundle). En Docker se pasan como ARG.
# Obligatoria: URL pública de la API (api-setube). Si falta, el build falla.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Opcional: URL pública del sitio (SEO, sitemap, OG).
NEXT_PUBLIC_SITE_URL=
# Opcional: site key de Cloudflare Turnstile. Vacía = sin captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
